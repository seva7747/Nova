# Copy to ".env" — points the frontend at your local backend.
VITE_API_BASE_URL=http://localhost:8787

# ── Wake word engine (optional but recommended) ─────────────────────────────
# Without this, Nova falls back automatically to the browser's built-in
# speech recognizer for the "Nova" wake word — works with zero setup, but
# it's dictation software repurposed as a keyword spotter, so it misses
# triggers and needs the internet for every check.
#
# Setting this key switches Nova to Picovoice Porcupine — a real, on-device
# wake-word engine, the same category of tech real Alexa devices use for
# this exact job. Far more reliable, near-instant, fully offline.
#
# To enable it:
#   1. Free account at https://console.picovoice.ai — copy your AccessKey
#      into VITE_PICOVOICE_ACCESS_KEY below.
#   2. On the same console: Porcupine → Create Wake Word → type "Nova" →
#      target platform "Web (WASM)" → Train → Download. Unzip it and place
#      the .ppn file at frontend/public/nova.ppn (exact filename matters).
#   3. That's it — frontend/public/porcupine_params.pv (the generic English
#      model Porcupine also needs) is already included in this repo.
#
# Nobody but you can do step 2 — it's a model trained specifically for your
# AccessKey and can't be generated or shared generically.
VITE_PICOVOICE_ACCESS_KEY=
